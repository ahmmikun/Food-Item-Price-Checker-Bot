# WhatsApp number with country code (required for pairing mode)
BOT_PHONE_NUMBER=923xxxxxxxxx

# Session folder name
SESSION_FOLDER=session

# Connection type: "pairing" or "qr"
# pairing = enter pairing code on your phone (no camera needed)
# qr = scan QR code from terminal with WhatsApp camera
CONNECTION_TYPE=pairing

# Auto-read incoming messages
AUTOREAD=true
